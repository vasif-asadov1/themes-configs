    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#8293AA",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "constant.other.symbol"
            ],
            "settings": {
                "foreground": "#89C9A6"
            }
        },
        {
            "name": "Escapes and interpolation",
            "scope": [
                "constant.character.escape",
                "constant.character",
                "punctuation.section.embedded",
                "meta.interpolation punctuation"
            ],
            "settings": {
                "foreground": "#59C9C2"
            }
        },
        {
            "name": "Numbers and units",
            "scope": [
                "constant.numeric",
                "constant.other.color",
                "keyword.other.unit"
            ],
            "settings": {
                "foreground": "#E7C080"
            }
        },
        {
            "name": "Constants and booleans",
            "scope": [
                "constant.language",
                "constant.other",
                "variable.other.constant"
            ],
            "settings": {
                "foreground": "#98FFB3"
            }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#B49AF0"
            }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "punctuation.accessor"
            ],
            "settings": {
                "foreground": "#59C9C2"
            }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call entity.name.function",
                "variable.function"
            ],
            "settings": {
                "foreground": "#64B5F6"
            }
        },
        {
            "name": "Classes and types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class",
                "storage.type.annotation"
            ],
            "settings": {
                "foreground": "#59C9C2"
            }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "meta.definition.variable"
            ],
            "settings": {
                "foreground": "#D4DEEB"
            }
        },
        {
            "name": "Parameters",
            "scope": [
                "variable.parameter",
                "meta.function.parameters variable"
            ],
            "settings": {
                "foreground": "#E7C080"
            }
        },
        {
            "name": "Built-in variables",
            "scope": [
                "variable.language",
                "support.variable"
            ],
            "settings": {
                "foreground": "#B49AF0"
            }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "support.type.property-name",
                "entity.name.tag.yaml"
            ],
            "settings": {
                "foreground": "#91CCFF"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace"
            ],
            "settings": {
                "foreground": "#8293AA"
            }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid.illegal",
                "invalid.deprecated"
            ],
            "settings": {
                "foreground": "#ED7786",
                "fontStyle": "underline"
            }
        },
        {
            "name": "Python decorators",
            "scope": [
                "meta.function.decorator",
                "entity.name.function.decorator",
                "punctuation.definition.decorator"
            ],
            "settings": {
                "foreground": "#B49AF0"
            }
        },
        {
            "name": "Python self and cls",
            "scope": [
                "variable.language.special.self.python",
                "variable.language.special.cls.python"
            ],
            "settings": {
                "foreground": "#B49AF0",
                "fontStyle": "italic"
            }
        },
        {
            "name": "SQL keywords and DDL",
            "scope": [
                "keyword.other.sql",
                "keyword.control.sql",
                "keyword.other.DML.sql",
                "keyword.other.DDL.sql",
                "keyword.other.DML",
                "keyword.other.DDL"
            ],
            "settings": {
                "foreground": "#B49AF0"
            }
        },
        {
            "name": "SQL functions and types",
            "scope": [
                "support.function.sql",
                "support.function.aggregate.sql",
                "support.function.scalar.sql"
            ],
            "settings": {
                "foreground": "#64B5F6"
            }
        },
        {
            "name": "SQL identifiers",
            "scope": [
                "entity.name.table.sql",
                "entity.name.schema.sql",
                "entity.name.database.sql",
                "entity.name.column.sql"
            ],
            "settings": {
                "foreground": "#59C9C2"
            }
        },
        {
            "name": "JSON and JSONC keys",
            "scope": [
                "support.type.property-name.json",
                "support.type.property-name.json.comments",
                "meta.object-literal.key.json",
                "string.json support.type.property-name"
            ],
            "settings": {
                "foreground": "#64B5F6"
            }
        },
        {
            "name": "TOML keys and tables",
            "scope": [
                "meta.tag.toml",
                "entity.name.tag.toml",
                "support.type.property-name.toml",
                "variable.key.toml",
                "meta.table.toml entity.name"
            ],
            "settings": {
                "foreground": "#64B5F6"
            }
        },
        {
            "name": "YAML keys",
            "scope": [
                "entity.name.tag.yaml",
                "meta.mapping.key.yaml string",
                "support.type.property-name.yaml"
            ],
            "settings": {
                "foreground": "#64B5F6"
            }
        },
        {
            "name": "R functions",
            "scope": [
                "support.function.r",
                "entity.name.function.r",
                "meta.function-call.r entity.name.function"
            ],
            "settings": {
                "foreground": "#64B5F6"
            }
        },
        {
            "name": "Markdown headings",
            "scope": [
                "markup.heading",
                "entity.name.section.markdown"
            ],
            "settings": {
                "foreground": "#64B5F6",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markdown bold",
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#E7C080",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markdown italic",
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "foreground": "#B49AF0",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markdown links",
            "scope": [
                "markup.underline.link",
                "string.other.link",
                "meta.link.inline.markdown string"
            ],
            "settings": {
                "foreground": "#59C9C2",
                "fontStyle": "underline"
            }
        },
        {
            "name": "Markdown code",
            "scope": [
                "markup.inline.raw",
                "markup.fenced_code",
                "markup.raw"
            ],
            "settings": {
                "foreground": "#89C9A6"
            }
        },
        {
            "name": "Markdown quote and lists",
            "scope": [
                "markup.quote",
                "punctuation.definition.list.begin",
                "punctuation.definition.blockquote"
            ],
            "settings": {
                "foreground": "#8293AA"
            }
        },
        {
            "name": "Markup tags",
            "scope": [
                "entity.name.tag",
                "punctuation.definition.tag"
            ],
            "settings": {
                "foreground": "#64B5F6"
            }
        },
        {
            "name": "Markup attributes",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#E7C080"
            }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": {
                "foreground": "#59C9C2"
            }
        },
        {
            "name": "CSS values",
            "scope": [
                "support.constant.property-value.css",
                "support.constant.color"
            ],
            "settings": {
                "foreground": "#98FFB3"
            }
        },
        {
            "name": "Shell commands",
            "scope": [
                "support.function.builtin.shell",
                "entity.name.command.shell"
            ],
            "settings": {
                "foreground": "#64B5F6"
            }
        },
        {
            "name": "Shell variables",
            "scope": [
                "variable.other.normal.shell",
                "variable.other.special.shell"
            ],
            "settings": {
                "foreground": "#59C9C2"
            }
        },
        {
            "name": "Regex",
            "scope": [
                "string.regexp"
            ],
            "settings": {
                "foreground": "#E7C080"
            }
        },
        {
            "name": "Diff inserted",
            "scope": [
                "markup.inserted"
            ],
            "settings": {
                "foreground": "#89C9A6"
            }
        },
        {
            "name": "Diff removed",
            "scope": [
                "markup.deleted"
            ],
