        "notebook.focusedCellBorder": "#64B5F6",
        "notebook.focusedEditorBorder": "#64B5F6",
        "notebook.selectedCellBorder": "#64B5F6",
        "editorCursor.foreground": "#64B5F6",
        "editorIndentGuide.activeBackground1": "#52657D",
        "textBlockQuote.border": "#52657D",
