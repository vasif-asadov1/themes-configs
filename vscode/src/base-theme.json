        "gitDecoration.renamedResourceForeground": "#B49AF0",
        "terminal.ansiBlack": "#354153",
        "terminal.ansiRed": "#ED7786",
        "terminal.ansiGreen": "#89C9A6",
        "terminal.ansiYellow": "#E7C080",
        "terminal.ansiBlue": "#64B5F6",
        "terminal.ansiMagenta": "#B49AF0",
        "terminal.ansiCyan": "#59C9C2",
        "terminal.ansiWhite": "#D4DEEB",
        "terminal.ansiBrightBlack": "#8293AA",
        "terminal.ansiBrightRed": "#FF96A4",
        "terminal.ansiBrightGreen": "#A5E3BB",
        "terminal.ansiBrightYellow": "#F5D69C",
        "terminal.ansiBrightBlue": "#91CCFF",
        "terminal.ansiBrightMagenta": "#D0B8FF",
        "terminal.ansiBrightCyan": "#87E3DC",
        "terminal.ansiBrightWhite": "#EDF4FF"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#8293AA",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "constant.other.symbol"
            ],
            "settings": {
                "foreground": "#89C9A6"
            }
        },
        {
            "name": "Escapes and interpolation",
            "scope": [
                "constant.character.escape",
                "constant.character",
                "punctuation.section.embedded",
                "meta.interpolation punctuation"
            ],
            "settings": {
                "foreground": "#59C9C2"
            }
        },
        {
            "name": "Numbers and units",
            "scope": [
                "constant.numeric",
                "constant.other.color",
                "keyword.other.unit"
            ],
            "settings": {
                "foreground": "#E7C080"
            }
        },
        {
            "name": "Constants and booleans",
            "scope": [
                "constant.language",
                "constant.other",
                "variable.other.constant"
            ],
            "settings": {
                "foreground": "#98FFB3"
            }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#B49AF0"
            }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "punctuation.accessor"
            ],
            "settings": {
                "foreground": "#59C9C2"
            }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call entity.name.function",
                "variable.function"
            ],
            "settings": {
                "foreground": "#64B5F6"
            }
        },
        {
            "name": "Classes and types",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.type",
                "support.class",
                "storage.type.annotation"
            ],
            "settings": {
                "foreground": "#59C9C2"
            }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "meta.definition.variable"
            ],
            "settings": {
                "foreground": "#D4DEEB"
            }
        },
        {
            "name": "Parameters",
            "scope": [
                "variable.parameter",
                "meta.function.parameters variable"
            ],
            "settings": {
                "foreground": "#E7C080"
            }
        },
        {
            "name": "Built-in variables",
            "scope": [
                "variable.language",
                "support.variable"
            ],
            "settings": {
                "foreground": "#B49AF0"
            }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "support.type.property-name",
                "entity.name.tag.yaml"
            ],
            "settings": {
                "foreground": "#91CCFF"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation",
                "meta.brace"
            ],
            "settings": {
                "foreground": "#8293AA"
            }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid.illegal",
                "invalid.deprecated"
            ],
            "settings": {
                "foreground": "#ED7786",
                "fontStyle": "underline"
            }
        },
        {
            "name": "Python decorators",
            "scope": [
                "meta.function.decorator",
                "entity.name.function.decorator",
                "punctuation.definition.decorator"
            ],
            "settings": {
                "foreground": "#B49AF0"
            }
        },
        {
            "name": "Python self and cls",
            "scope": [
                "variable.language.special.self.python",
                "variable.language.special.cls.python"
            ],
            "settings": {
                "foreground": "#B49AF0",
                "fontStyle": "italic"
            }
        },
        {
            "name": "SQL keywords and DDL",
            "scope": [
                "keyword.other.sql",
                "keyword.control.sql",
                "keyword.other.DML.sql",
                "keyword.other.DDL.sql",
                "keyword.other.DML",
                "keyword.other.DDL"
            ],
            "settings": {
                "foreground": "#B49AF0"
            }
        },
        {
            "name": "SQL functions and types",
            "scope": [
                "support.function.sql",
                "support.function.aggregate.sql",
                "support.function.scalar.sql"
            ],
            "settings": {
                "foreground": "#64B5F6"
            }
        },
        {
            "name": "SQL identifiers",
            "scope": [
                "entity.name.table.sql",
                "entity.name.schema.sql",
                "entity.name.database.sql",
                "entity.name.column.sql"
            ],
            "settings": {
                "foreground": "#59C9C2"
            }
        },
        {
            "name": "JSON and JSONC keys",
            "scope": [
                "support.type.property-name.json",
                "support.type.property-name.json.comments",
                "meta.object-literal.key.json",
                "string.json support.type.property-name"
            ],
            "settings": {
                "foreground": "#64B5F6"
            }
        },
        {
            "name": "TOML keys and tables",
            "scope": [
                "meta.tag.toml",
                "entity.name.tag.toml",
                "support.type.property-name.toml",
                "variable.key.toml",
                "meta.table.toml entity.name"
            ],
            "settings": {
                "foreground": "#64B5F6"
            }
        },
        {
            "name": "YAML keys",
            "scope": [
                "entity.name.tag.yaml",
                "meta.mapping.key.yaml string",
                "support.type.property-name.yaml"
            ],
            "settings": {
                "foreground": "#64B5F6"
            }
        },
        {
            "name": "R functions",
            "scope": [
                "support.function.r",
                "entity.name.function.r",
                "meta.function-call.r entity.name.function"
            ],
            "settings": {
                "foreground": "#64B5F6"
            }
        },
        {
            "name": "Markdown headings",
            "scope": [
                "markup.heading",
                "entity.name.section.markdown"
            ],
            "settings": {
                "foreground": "#64B5F6",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markdown bold",
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#E7C080",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markdown italic",
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "foreground": "#B49AF0",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markdown links",
            "scope": [
                "markup.underline.link",
                "string.other.link",
                "meta.link.inline.markdown string"
            ],
            "settings": {
                "foreground": "#59C9C2",
                "fontStyle": "underline"
            }
        },
        {
            "name": "Markdown code",
            "scope": [
                "markup.inline.raw",
                "markup.fenced_code",
                "markup.raw"
            ],
            "settings": {
                "foreground": "#89C9A6"
            }
        },
        {
            "name": "Markdown quote and lists",
            "scope": [
                "markup.quote",
                "punctuation.definition.list.begin",
                "punctuation.definition.blockquote"
            ],
            "settings": {
                "foreground": "#8293AA"
            }
        },
        {
            "name": "Markup tags",
            "scope": [
                "entity.name.tag",
                "punctuation.definition.tag"
            ],
            "settings": {
                "foreground": "#64B5F6"
            }
        },
        {
            "name": "Markup attributes",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#E7C080"
            }
        },
        {
            "name": "CSS selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css"
            ],
            "settings": {
                "foreground": "#59C9C2"
            }
        },
        {
            "name": "CSS values",
            "scope": [
                "support.constant.property-value.css",
                "support.constant.color"
            ],
            "settings": {
                "foreground": "#98FFB3"
            }
        },
        {
            "name": "Shell commands",
            "scope": [
                "support.function.builtin.shell",
                "entity.name.command.shell"
            ],
            "settings": {
                "foreground": "#64B5F6"
            }
        },
        {
            "name": "Shell variables",
            "scope": [
                "variable.other.normal.shell",
                "variable.other.special.shell"
            ],
            "settings": {
                "foreground": "#59C9C2"
            }
        },
        {
            "name": "Regex",
            "scope": [
                "string.regexp"
            ],
            "settings": {
                "foreground": "#E7C080"
            }
        },
        {
            "name": "Diff inserted",
            "scope": [
                "markup.inserted"
            ],
            "settings": {
                "foreground": "#89C9A6"
            }
        },
        {
            "name": "Diff removed",
            "scope": [
                "markup.deleted"
            ],
            "settings": {
                "foreground": "#ED7786"
            }
        },
        {
            "name": "Diff changed",
            "scope": [
                "markup.changed"
            ],
            "settings": {
                "foreground": "#E7C080"
            }
        },
        {
            "name": "Log severity",
            "scope": [
                "markup.error",
                "log.error"
            ],
            "settings": {
                "foreground": "#ED7786"
            }
        }
    ],
    "semanticTokenColors": {
        "namespace": "#59C9C2",
        "type": "#59C9C2",
        "class": "#59C9C2",
        "enum": "#59C9C2",
        "interface": "#59C9C2",
        "struct": "#59C9C2",
        "typeParameter": "#59C9C2",
        "parameter": "#E7C080",
        "variable": "#D4DEEB",
        "property": "#91CCFF",
        "enumMember": "#98FFB3",
        "event": "#B49AF0",
        "function": "#64B5F6",
        "method": "#64B5F6",
        "macro": "#B49AF0",
        "label": "#E7C080",
        "comment": {
            "foreground": "#8293AA",
            "italic": true
        },
        "string": "#89C9A6",
        "keyword": "#B49AF0",
        "number": "#E7C080",
        "regexp": "#E7C080",
        "operator": "#59C9C2",
        "decorator": "#B49AF0",
        "variable.readonly": "#98FFB3",
        "property.readonly": "#98FFB3",
        "*.deprecated": {
            "strikethrough": true
        }
    }
}
