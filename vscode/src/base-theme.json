        "badge.background": "#307FA7",
        "activityBarBadge.background": "#307FA7",
        "button.foreground": "#EDF4FF",
        "badge.foreground": "#EDF4FF",
        "activityBarBadge.foreground": "#EDF4FF",
        "menu.selectionForeground": "#EDF4FF",
        "quickInputList.focusForeground": "#EDF4FF",
        "editorSuggestWidget.selectedForeground": "#EDF4FF",
        "terminal.selectionForeground": "#EDF4FF",
        "button.hoverBackground": "#3A91BA",
        "statusBar.background": "#182B3B",
        "statusBarItem.remoteBackground": "#182B3B",
        "tab.activeBackground": "#151B23",
        "tab.unfocusedActiveBackground": "#151B23",
        "scrollbarSlider.background": "#40556C80",
        "minimapSlider.background": "#40556C80",
        "scrollbarSlider.hoverBackground": "#52657DA0",
        "minimapSlider.hoverBackground": "#52657DA0",
        "scrollbarSlider.activeBackground": "#64B5F680",
        "minimapSlider.activeBackground": "#64B5F680",
        "editor.findMatchBackground": "#E7C08044",
        "editor.findMatchHighlightBackground": "#E7C08044",
        "editorOverviewRuler.findMatchForeground": "#E7C08044",
        "editor.wordHighlightBackground": "#64B5F625",
        "editor.wordHighlightStrongBackground": "#64B5F625",
        "editor.selectionHighlightBackground": "#64B5F625",
        "diffEditor.insertedTextBackground": "#89C9A625",
        "diffEditor.insertedLineBackground": "#89C9A625",
        "diffEditor.removedTextBackground": "#ED778625",
        "diffEditor.removedLineBackground": "#ED778625",
        "editorInlayHint.background": "#222D3A",
